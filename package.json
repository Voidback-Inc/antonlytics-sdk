{
  "name": "@antonlytics/sdk",
  "version": "1.0.0",
  "description": "Official JavaScript / TypeScript SDK for the Antonlytics Knowledge Graph API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "anto": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --clean --splitting false",
    "build:watch": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "antonlytics",
    "knowledge-graph",
    "ontology",
    "sdk",
    "triplet",
    "graph"
  ],
  "author": "Antonlytics <sdk@antonlytics.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonlytics/sdk-js"
  },
  "homepage": "https://docs.antonlytics.com/sdk/javascript",
  "bugs": {
    "url": "https://github.com/antonlytics/sdk-js/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
